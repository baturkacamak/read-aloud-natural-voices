{
  "manifest_version": 3,
  "default_locale": "tr",
  "name": "__MSG_appName__",
  "version": "0.7.1",
  "description": "__MSG_appDescription__",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://speech.platform.bing.com/*",
    "wss://speech.platform.bing.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/locales/base.js",
        "src/i18n.js",
        "src/themes.js",
        "src/library.js",
        "src/settings.js",
        "src/tools.js",
        "src/vendor/audio/codecs.js",
        "src/audio-export.js",
        "src/experience.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "read-page": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "__MSG_commandReadPage__"
    },
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_commandReadSelection__"
    },
    "read-here": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "__MSG_commandReadHere__"
    },
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+Space"
      },
      "description": "__MSG_commandToggle__"
    },
    "stop": {
      "description": "__MSG_commandStop__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/vendor/98.css/*.woff2",
        "src/assets/theme-icons/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
